# Linux ownership for mounted folders. Replace with the output of id -u / id -g.
HOST_UID=1000
HOST_GID=1000

TZ=Pacific/Auckland
RUN_HOUR=6
RUN_MINUTE=30
LOG_LEVEL=INFO

GARMIN_EMAIL=
GARMIN_PASSWORD=

TOKEN_DIR=/tokens
DATA_DIR=/data
PLAN_CONFIG=/config/plan.yaml
EVIDENCE_CONFIG=/config/evidence.yaml

# Garmin calendar writes. Keep disabled while previewing.
GARMIN_WRITE_ENABLED=false
DRY_RUN=true

# Daily recovery thresholds.
READINESS_RED=25
READINESS_AMBER=50
SLEEP_RED_HOURS=5.0
SLEEP_AMBER_HOURS=6.5
SLEEP_SCORE_RED=50
SLEEP_SCORE_AMBER=70
HRV_RED_RATIO=0.80
HRV_AMBER_RATIO=0.90
RHR_RED_DELTA=5
RHR_AMBER_DELTA=3

# Feedback is read from completed activity descriptions in Garmin Connect.
SUBJECTIVE_FEEDBACK_DAYS=4
# Parsed values are stored; the full private description is not stored by default.
STORE_RAW_ACTIVITY_DESCRIPTION=false
SORENESS_RED=8
SORENESS_AMBER=6
FATIGUE_RED=8
FATIGUE_AMBER=6
MOTIVATION_RED=2
MOTIVATION_AMBER=4

# Weekly analysis and local AI.
ANALYSIS_DAYS=42
AI_REVIEW_DAY=sunday
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=qwen3:30b-a3b
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=120

# The safe default records AI proposals but never changes the plan from them.
AI_SHADOW_MODE=true
COACH_AUTO_APPLY=false
