# Linux ownership for mounted folders. Replace with the output of id -u / id -g.
HOST_UID=1000
HOST_GID=1000

TZ=Pacific/Auckland
RUN_HOUR=6
RUN_MINUTE=30
LOG_LEVEL=INFO

GARMIN_EMAIL=
GARMIN_PASSWORD=

TOKEN_DIR=/tokens
DATA_DIR=/data
PLAN_CONFIG=/config/plan.yaml
EVIDENCE_CONFIG=/config/evidence.yaml

# Garmin calendar writes. Keep disabled while previewing.
GARMIN_WRITE_ENABLED=false
DRY_RUN=true

# Daily recovery thresholds.
READINESS_RED=25
READINESS_AMBER=50
SLEEP_RED_HOURS=5.0
SLEEP_AMBER_HOURS=6.5
SLEEP_SCORE_RED=50
SLEEP_SCORE_AMBER=70
HRV_RED_RATIO=0.80
HRV_AMBER_RATIO=0.90
RHR_RED_DELTA=5
RHR_AMBER_DELTA=3

# Feedback is read from completed activity descriptions in Garmin Connect.
SUBJECTIVE_FEEDBACK_DAYS=4
# Parsed values are stored; the full private description is not stored by default.
STORE_RAW_ACTIVITY_DESCRIPTION=false
SORENESS_RED=8
SORENESS_AMBER=6
FATIGUE_RED=8
FATIGUE_AMBER=6
MOTIVATION_RED=2
MOTIVATION_AMBER=4

# Weekly analysis and local AI.
ANALYSIS_DAYS=42
AI_REVIEW_DAY=sunday

# Optional: date you began consistent structured endurance/triathlon training.
# Use YYYY-MM-DD. Leave empty to disable training-age context.
STRUCTURED_TRAINING_START_DATE=

# Master switch. When false, PyTorch and the model are never loaded.
AI_ENABLED=false

# embedded: load Qwen directly inside the V5 Phase 1 Docker service.
# external: call an OpenAI-compatible Ollama/vLLM endpoint.
AI_BACKEND=embedded
AI_MODEL=Qwen/Qwen3-30B-A3B

# Embedded-model settings. The default RAM requirement is estimated from the
# model name and dtype. Set LOCAL_AI_REQUIRED_RAM_GB to a positive number only
# when you deliberately want to override the estimate.
LOCAL_AI_RAM_CHECK_MODE=strict
LOCAL_AI_REQUIRED_RAM_GB=0
LOCAL_AI_RAM_RESERVE_GB=8
LOCAL_AI_DTYPE=auto
LOCAL_AI_DEVICE_MAP=auto
LOCAL_AI_MAX_NEW_TOKENS=1400
LOCAL_AI_TEMPERATURE=0
LOCAL_AI_TOP_P=0.8
LOCAL_AI_TOP_K=20
LOCAL_AI_ENABLE_THINKING=false
LOCAL_AI_TRUST_REMOTE_CODE=false
LOCAL_AI_CPU_THREADS=0
HF_HOME=/models/huggingface
LOCAL_AI_OFFLOAD_DIR=/models/offload

# Used only when AI_BACKEND=external.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=120

# The safe default records AI proposals but never changes the plan from them.
AI_SHADOW_MODE=true
COACH_AUTO_APPLY=false

# Read-only local dashboard. Keep the bind address on a trusted network.
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080


# Weekly Garmin calendar publication. The advisor still runs daily for recovery,
# but it only extends the future calendar on this weekday. Sunday publication
# keeps two full upcoming weeks visible and normally adds one new week.
PLAN_PUBLISH_WEEKDAY=sunday
PLAN_PUBLISH_WEEKS=2
PLAN_PUBLISH_BOOTSTRAP_WHEN_EMPTY=true

# Structured Garmin workout targets. Values are optional manual overrides; when
# blank, V5 uses compatible benchmark results from data/training.db. Pace values
# use MM:SS (RUN_THRESHOLD_PACE per km, SWIM_CSS_PACE per 100 m).
WORKOUT_TARGETS_ENABLED=true
# Ignore low-confidence benchmark summaries; matching benchmark laps are normally
# above this threshold.
WORKOUT_TARGET_MIN_CONFIDENCE=0.65
RUN_THRESHOLD_PACE=
RUN_THRESHOLD_HR=
BIKE_FTP_WATTS=
BIKE_THRESHOLD_HR=
SWIM_CSS_PACE=

# V5 Phase 1 measurement foundation.
TRAINING_DB_ENABLED=true
TRAINING_DB_PATH=/data/training.db
# First full import. The normal daily sync only refreshes the recent window.
MEASUREMENT_HISTORY_DAYS=180
MEASUREMENT_SYNC_ON_DAILY=true
MEASUREMENT_DAILY_SYNC_DAYS=42

# Personal benchmark tracking. Enabling benchmarks makes them visible and due
# in the dashboard. AUTO_SCHEDULE=false means no normal workout is replaced yet.
BENCHMARKS_ENABLED=true
BENCHMARK_AUTO_SCHEDULE=false
